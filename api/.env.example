DATABASE_URL="postgresql://finance:finance@localhost:5435/finance"

# ── Open Finance (somente leitura) ──────────────────────────────────────────
# Provedor ativo: "pluggy" (padrão) ou "mock" (dados falsos, sem rede/credencial).
OPEN_FINANCE_PROVIDER=pluggy

# Pluggy — credenciais da aplicação (https://dashboard.pluggy.ai).
# Usadas SOMENTE no backend para gerar o X-API-KEY de curta duração.
# Nunca expor no frontend.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional — sobrescreve a URL base da API do provedor.
PLUGGY_BASE_URL=https://api.pluggy.ai

# Conector usado ao criar conexão pelo backend quando não se passa connectorId.
# 2 = "Pluggy Bank" (sandbox). Em produção, use o id do banco real
# ou envie o itemId gerado pelo widget Pluggy Connect.
OPEN_FINANCE_DEFAULT_CONNECTOR_ID=2

# Segredo opcional para validar o webhook do provedor.
# Se preenchido, o POST /open-finance/webhooks exige o header
# "x-webhook-secret" (ou ?secret=) com este valor.
OPEN_FINANCE_WEBHOOK_SECRET=
