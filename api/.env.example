DATABASE_URL="postgresql://finance:finance@localhost:5435/finance"

# ── Camada de LLM (classificação e narrativa do check-up) ───────────────────
# Nada quebra sem IA: toda rota que usa LLM responde `aiAvailable: boolean`
# e degrada (ver .claude/docs/api/llm.md).

# "ollama" (padrão, local e gratuito) | "anthropic" (nuvem) | "mock" (testes)
LLM_PROVIDER=ollama
# Sobrescreve o modelo default do provedor.
# ollama → qwen2.5:7b-instruct | anthropic → claude-haiku-4-5
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Obrigatória só quando LLM_PROVIDER=anthropic. Nunca aparece em log.
ANTHROPIC_API_KEY=
LLM_TIMEOUT_MS=60000
# Timeout só da narrativa mensal. Ela é a chamada mais pesada (prompt de ~1.000
# tokens) e a mais rara (uma por mês), e num modelo local em CPU passa dos 60s
# padrão — o relatório caía em NARRATION_FAILED por impaciência, não por erro.
LLM_NARRATIVE_TIMEOUT_MS=180000
# "false" desliga a IA em todo o app.
LLM_ENABLED=true
# "true" loga prompt e resposta no stdout (nunca no banco).
LLM_DEBUG=false
